# Copy to .env.local for local dev. Never commit real values.
# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=
# Bearer token for the phone app, Shortcuts, the tick workflow and Claude Code (generate with: npm run gen-token)
API_TOKEN=
# Optional second secret used only in the claude.ai connector URL: https://<app>.vercel.app/mcp/<MCP_KEY>
MCP_KEY=
